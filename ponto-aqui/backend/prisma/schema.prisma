// Ponto Aqui — schema do banco (PostgreSQL)
// Reflete docs/modelagem-dados.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  superadmin
  rh
  gestor
  funcionario
  usuario_setor
}

enum TipoEscala {
  fixa_semanal
  escala_turno
}

enum ModeloEscala {
  ciclo_24x72
  ciclo_12x36
  diurno
  comercial_5x2
}

enum TipoDispositivo {
  pessoal
  modo_relogio
}

enum StatusDispositivo {
  ativo
  aguardando
  bloqueado
}

enum TipoMarcacao {
  entrada
  saida_intervalo
  retorno_intervalo
  saida
}

enum OrigemMarcacao {
  online
  offline_sincronizada
}

enum SituacaoMarcacao {
  aceita
  pendente_analise
  recusada
}

enum StatusJustificativa {
  aberta
  aprovada
  reprovada
}

enum TipoAjuste {
  corrigir
  incluir
}

enum StatusFechamento {
  aberto
  fechado
}

enum PoliticaForaPerimetro {
  bloquear
  pendente_analise
}

model Empresa {
  id          String   @id @default(uuid())
  razaoSocial String   @map("razao_social")
  cnpj        String?  @unique
  contato     String?
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now()) @map("criado_em")

  usuarios     Usuario[]
  setores      Setor[]
  feriados     Feriado[]
  afastamentos Afastamento[]

  @@map("empresa")
}

model Usuario {
  id        String   @id @default(uuid())
  empresaId String?  @map("empresa_id")
  nome      String
  email     String   @unique
  login     String?  @unique
  senhaHash String   @map("senha_hash")
  matricula String?
  cargo     String?
  perfil    Perfil
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  empresa           Empresa?           @relation(fields: [empresaId], references: [id])
  alocacoes         FuncionarioSetor[]
  dispositivos      Dispositivo[]
  marcacoes         Marcacao[]
  justificativas    Justificativa[]
  ajustes           AjusteMarcacao[]
  fechamentos       FechamentoPeriodo[]
  afastamentos      Afastamento[]

  @@map("usuario")
  @@unique([empresaId, matricula])
}

model Setor {
  id                 String   @id @default(uuid())
  empresaId          String   @map("empresa_id")
  nome               String
  endereco           String?
  latitude           Float
  longitude          Float
  raioMetros         Int      @map("raio_metros")
  ignoraLocalizacao  Boolean  @default(false) @map("ignora_localizacao")
  exigeSelfie        Boolean  @default(false) @map("exige_selfie")
  politicaForaPerimetro PoliticaForaPerimetro @default(bloquear) @map("politica_fora_perimetro")

  empresa      Empresa            @relation(fields: [empresaId], references: [id])
  escalas      Escala[]
  alocacoes    FuncionarioSetor[]
  dispositivos Dispositivo[]
  marcacoes    Marcacao[]
  feriados     Feriado[]

  @@map("setor")
}

model Escala {
  id                  String     @id @default(uuid())
  empresaId           String     @map("empresa_id")
  setorId             String     @map("setor_id")
  nome                String
  tipo                TipoEscala
  modelo              ModeloEscala @default(comercial_5x2)
  dataReferencia      DateTime?   @map("data_referencia")
  cargaDiariaMinutos  Int        @map("carga_diaria_minutos")
  toleranciaMinutos   Int        @map("tolerancia_minutos")
  regraJson           Json       @map("regra_json")

  setor     Setor              @relation(fields: [setorId], references: [id])
  alocacoes FuncionarioSetor[]
  turnos    TurnoEscala[]

  @@map("escala")
}

model TurnoEscala {
  id               String   @id @default(uuid())
  escalaId         String   @map("escala_id")
  diaSemana        Int?     @map("dia_semana")
  horaInicio       String   @map("hora_inicio")
  horaFim          String   @map("hora_fim")
  intervaloMinutos Int      @default(0) @map("intervalo_minutos")

  escala Escala @relation(fields: [escalaId], references: [id], onDelete: Cascade)

  @@index([escalaId, diaSemana])
  @@map("turno_escala")
}

model FuncionarioSetor {
  id              String    @id @default(uuid())
  empresaId       String    @map("empresa_id")
  usuarioId       String    @map("usuario_id")
  setorId         String    @map("setor_id")
  escalaId        String    @map("escala_id")
  vigenciaInicio  DateTime  @map("vigencia_inicio")
  vigenciaFim     DateTime? @map("vigencia_fim")

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  setor   Setor   @relation(fields: [setorId], references: [id])
  escala  Escala  @relation(fields: [escalaId], references: [id])

  @@map("funcionario_setor")
}

model Dispositivo {
  id             String            @id @default(uuid())
  empresaId      String?           @map("empresa_id")
  usuarioId      String?           @map("usuario_id")
  setorId        String?           @map("setor_id")
  identificador  String            @unique
  tipo           TipoDispositivo
  status         StatusDispositivo @default(aguardando)
  ultimoLoginEm  DateTime?         @map("ultimo_login_em")

  usuario   Usuario?    @relation(fields: [usuarioId], references: [id])
  setor     Setor?      @relation(fields: [setorId], references: [id])
  marcacoes Marcacao[]

  @@map("dispositivo")
}

model Marcacao {
  id                     String         @id @default(uuid())
  empresaId              String         @map("empresa_id")
  usuarioId              String         @map("usuario_id")
  setorId                String         @map("setor_id")
  dispositivoId          String         @map("dispositivo_id")
  tipo                   TipoMarcacao
  horaDispositivo        DateTime       @map("hora_dispositivo")
  desvioServidorSegundos Int            @map("desvio_servidor_segundos")
  horaServidor           DateTime       @map("hora_servidor")
  latitude               Float?
  longitude              Float?
  distanciaMetros        Float?         @map("distancia_metros")
  dentroPerimetro        Boolean?       @map("dentro_perimetro")
  selfieUrl              String?        @map("selfie_url")
  origem                 OrigemMarcacao
  situacao               SituacaoMarcacao @default(aceita)
  recebidoEm             DateTime        @default(now()) @map("recebido_em")
  idLocal                String         @unique @map("id_local")
  criadoEm               DateTime       @default(now()) @map("criado_em")

  usuario     Usuario          @relation(fields: [usuarioId], references: [id])
  setor       Setor            @relation(fields: [setorId], references: [id])
  dispositivo Dispositivo      @relation(fields: [dispositivoId], references: [id])
  ajuste      AjusteMarcacao?

  @@map("marcacao")
}

model Feriado {
  id        String   @id @default(uuid())
  empresaId String   @map("empresa_id")
  setorId   String?  @map("setor_id")
  data      DateTime
  descricao String
  criadoEm  DateTime @default(now()) @map("criado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id])
  setor   Setor?  @relation(fields: [setorId], references: [id])

  @@unique([empresaId, setorId, data])
  @@index([empresaId, data])
  @@map("feriado")
}

model Afastamento {
  id         String   @id @default(uuid())
  empresaId  String   @map("empresa_id")
  usuarioId  String   @map("usuario_id")
  tipo       String
  dataInicio DateTime @map("data_inicio")
  dataFim    DateTime @map("data_fim")
  anexoUrl   String?  @map("anexo_url")
  criadoEm   DateTime @default(now()) @map("criado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([empresaId, usuarioId, dataInicio, dataFim])
  @@map("afastamento")
}

model Justificativa {
  id             String              @id @default(uuid())
  empresaId      String              @map("empresa_id")
  usuarioId      String              @map("usuario_id")
  dataOcorrencia DateTime            @map("data_ocorrencia")
  tipo           String
  descricao      String
  anexoUrl       String?             @map("anexo_url")
  status         StatusJustificativa @default(aberta)
  parecer        String?
  analisadoPor   String?             @map("analisado_por")
  analisadoEm    DateTime?           @map("analisado_em")

  usuario Usuario          @relation(fields: [usuarioId], references: [id])
  ajustes AjusteMarcacao[]

  @@map("justificativa")
}

model AjusteMarcacao {
  id                String     @id @default(uuid())
  empresaId         String     @map("empresa_id")
  usuarioId         String     @map("usuario_id")
  marcacaoId        String?    @unique @map("marcacao_id")
  tipo              TipoAjuste
  horarioSolicitado DateTime   @map("horario_solicitado")
  justificativaId   String     @map("justificativa_id")
  status            StatusJustificativa @default(aberta)
  parecer           String?
  analisadoPor      String?    @map("analisado_por")
  analisadoEm       DateTime?  @map("analisado_em")
  criadoEm          DateTime   @default(now()) @map("criado_em")

  usuario       Usuario       @relation(fields: [usuarioId], references: [id])
  marcacao      Marcacao?     @relation(fields: [marcacaoId], references: [id])
  justificativa Justificativa @relation(fields: [justificativaId], references: [id])

  @@map("ajuste_marcacao")
}

model FechamentoPeriodo {
  id                  String           @id @default(uuid())
  empresaId           String           @map("empresa_id")
  usuarioId           String           @map("usuario_id")
  competencia         String
  status              StatusFechamento @default(aberto)
  fechadoPor          String?          @map("fechado_por")
  fechadoEm           DateTime?        @map("fechado_em")
  saldoHorasMinutos   Int?             @map("saldo_horas_minutos")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, competencia])
  @@map("fechamento_periodo")
}
